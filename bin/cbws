"""
cbws - interactive colcon build manager for a ROS 2 workspace.

Usage:
  cbws [-w WS] [-s]

  -w WS   workspace root (default: found from the current directory upwards)
  -s      print a status table and exit (non-interactive)

It replaces the cb / cbp / cbu / cbs / cbpr aliases:
  B  build all            (cb)       b  only selected      (cbp)
  u  up to selected       (cbu)      a  from selected      (cbs)
  t  cycle build type     (Default / Debug / Release / RelWithDebInfo / MinSizeRel)
  x  clean selected       X  clean whole workspace
  l  build log of the package (cbfail viewer), L browse the last build
Press ? inside for the full list. Space marks several packages: actions then
apply to all marked packages instead of the selected one.
"""
import argparse
import curses
import importlib.machinery
import importlib.util
import json
import locale
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor

BUILD_TYPES = [None, "Debug", "Release", "RelWithDebInfo", "MinSizeRel"]
BT_SHORT = {"RelWithDebInfo": "RelWDeb", "MinSizeRel": "MinSize"}
DEFAULT_OPTS = dict(build_type=None, jobs=0, symlink=True, continue_on_error=True,
                    compile_commands=True, clean_cache=False, force_configure=False,
                    extra_cmake="", extra_colcon="")
SETTINGS = os.path.expanduser("~/.config/cbws/settings.json")
SKIP_DIRS = {"build", "install", "log", "__pycache__", "node_modules", "venv"}
EVENT_RE = re.compile(r"^\[([0-9.]+)\] \(([^)]*)\) (\w+): (.*)$")
RC_RE = re.compile(r"'rc': '?([^,'}]+)'?")
EDGE_RE = re.compile(r'^\s*"([^"]+)" -> "([^"]+)"')
STATUS_ORDER = {"FAILED": 0, "ABORTED": 1, "SKIPPED": 2, "RUNNING": 3, "never": 4, "OK": 5}

RED, YELLOW, GREEN, MAGENTA, CYAN, BLUE, TITLE = range(1, 8)  # 1-6 match cbfail


def load_cbfail():
    """Import ~/.local/bin/cbfail as a module to reuse its log parsing and viewer."""
    here = os.path.dirname(os.path.realpath(__file__))
    path = os.path.join(here, "cbfail")
    if not os.path.exists(path):
        path = shutil.which("cbfail")
    if not path:
        return None
    try:
        sys.dont_write_bytecode = True
        loader = importlib.machinery.SourceFileLoader("cbfail_mod", path)
        spec = importlib.util.spec_from_loader("cbfail_mod", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:  # noqa
        return None


cbfail = load_cbfail()


# ---------------------------------------------------------------------------
# Workspace model
# ---------------------------------------------------------------------------
def find_ws(start):
    d = os.path.abspath(start)
    first_src = None
    while True:
        if os.path.isdir(os.path.join(d, "src")):
            if any(os.path.isdir(os.path.join(d, x)) for x in ("build", "install", "log")):
                return d
            first_src = first_src or d
        parent = os.path.dirname(d)
        if parent == d:
            return first_src or os.path.abspath(start)
        d = parent


def colcon_q(ws, *args):
    """Run a read-only colcon command without writing anything to log/."""
    try:
        p = subprocess.run(["colcon", "--log-base", os.devnull, *args], cwd=ws,
                           capture_output=True, text=True, errors="replace", timeout=120)
        return p.returncode, p.stdout, p.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def ago(t):
    if t is None:
        return ""
    s = time.time() - t
    if s < 60:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)} min ago"
    if s < 86400:
        return f"{int(s // 3600)} h ago"
    return f"{int(s // 86400)} d ago"


def fmt_dur(d):
    if d is None:
        return ""
    if d < 60:
        return f"{d:.1f}s"
    return f"{int(d // 60)}m{int(d % 60):02d}"


def colcon_running(ws):
    """PID of a 'colcon build' whose working directory is this workspace, if any."""
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().split(b"\0")
            if not any(os.path.basename(c) == b"colcon" for c in cmd[:2]) or b"build" not in cmd:
                continue
            if os.path.realpath(f"/proc/{pid}/cwd") == ws:
                return int(pid)
        except OSError:
            continue
    return None


class Pkg:
    def __init__(self, name, path, ptype, order):
        self.name, self.path, self.ptype, self.order = name, path, ptype, order
        self.deps, self.rdeps = set(), set()
        self.status = "never"
        self.rc = None
        self.t_end = None
        self.dur = None
        self.build_dir = None
        self.last_ok = None
        self.n_err = self.n_warn = 0
        self.build_type = None  # None: not configured / not cmake
        self.newest_src = None
        self.changed = False

    @property
    def is_cmake(self):
        return "cmake" in self.ptype

    @property
    def short_type(self):
        return {"ros.ament_cmake": "ament", "ros.ament_python": "python",
                "ros.cmake": "cmake", "cmake": "cmake"}.get(self.ptype, self.ptype)

    def problem(self):
        return self.status != "OK" or self.changed or self.n_err > 0


class Workspace:
    def __init__(self, root):
        self.root = root
        self.log_root = os.path.join(root, "log")
        self.pkgs = {}
        self.error = None
        self.running_pid = None

    def load_packages(self):
        with ThreadPoolExecutor(2) as ex:
            f_list = ex.submit(colcon_q, self.root, "list", "-t")
            f_graph = ex.submit(colcon_q, self.root, "graph", "--dot")
            rc, out, err = f_list.result()
            grc, gout, _ = f_graph.result()
        if rc != 0:
            self.error = (err.strip().splitlines() or ["colcon list failed"])[-1]
            return
        pkgs = {}
        for i, line in enumerate(out.splitlines()):
            parts = line.split("\t")
            if len(parts) >= 3:
                pkgs[parts[0]] = Pkg(parts[0], parts[1], parts[2].strip("()"), i)
        if grc == 0:
            for line in gout.splitlines():
                m = EDGE_RE.match(line)
                if m and m.group(1) in pkgs and m.group(2) in pkgs:
                    pkgs[m.group(1)].deps.add(m.group(2))
                    pkgs[m.group(2)].rdeps.add(m.group(1))
        self.pkgs = pkgs

    def builds(self):
        if not os.path.isdir(self.log_root):
            return []
        names = sorted((n for n in os.listdir(self.log_root) if n.startswith("build_")
                        and os.path.isdir(os.path.join(self.log_root, n))), reverse=True)
        return [os.path.join(self.log_root, n) for n in names]

    @staticmethod
    def build_start(build_dir):
        try:
            return time.mktime(time.strptime(os.path.basename(build_dir), "build_%Y-%m-%d_%H-%M-%S"))
        except ValueError:
            return os.path.getmtime(build_dir)

    @staticmethod
    def parse_events(build_dir):
        """{pkg: dict(status, rc, t0, t1)} for one build."""
        res = {}
        try:
            f = open(os.path.join(build_dir, "events.log"), errors="replace")
        except OSError:
            return res
        with f:
            for raw in f:
                m = EVENT_RE.match(raw.rstrip("\n"))
                if not m or m.group(2) == "-":
                    continue
                t, ident, ev, payload = float(m.group(1)), m.group(2), m.group(3), m.group(4)
                if ev == "JobUnselected":
                    continue
                e = res.setdefault(ident, dict(status=None, rc=None, t0=None, t1=None))
                if ev == "JobStarted":
                    e["t0"], e["status"] = t, "RUNNING"
                elif ev == "JobEnded":
                    rm = RC_RE.search(payload)
                    rc = rm.group(1) if rm else "?"
                    e["t1"], e["rc"] = t, rc
                    e["status"] = "OK" if rc == "0" else ("ABORTED" if rc.startswith("SIG") else "FAILED")
                elif ev == "JobSkipped":
                    e["status"] = "SKIPPED"
        return res

    def scan_history(self, max_builds=60):
        """Most recent build outcome of every package, looking back over old builds."""
        self.running_pid = colcon_running(self.root)
        pending = set(self.pkgs)
        need_ok = set(self.pkgs)
        for p in self.pkgs.values():
            p.status, p.rc, p.t_end, p.dur, p.build_dir, p.last_ok = "never", None, None, None, None, None
        for bi, bdir in enumerate(self.builds()[:max_builds]):
            if not pending and not need_ok:
                break
            start = self.build_start(bdir)
            for name, e in self.parse_events(bdir).items():
                p = self.pkgs.get(name)
                if p is None or e["status"] is None:
                    continue
                if e["status"] == "RUNNING" and not (bi == 0 and self.running_pid):
                    continue  # interrupted without an end event: look at older builds
                if name in pending:
                    pending.discard(name)
                    p.status, p.rc, p.build_dir = e["status"], e["rc"], bdir
                    p.t_end = start + e["t1"] if e["t1"] is not None else None
                    p.dur = e["t1"] - e["t0"] if e["t1"] is not None and e["t0"] is not None else None
                if name in need_ok and e["status"] == "OK":
                    need_ok.discard(name)
                    p.last_ok = start + e["t1"]
        for p in self.pkgs.values():
            p.build_type = None
            cache = os.path.join(self.root, "build", p.name, "CMakeCache.txt")
            if p.is_cmake and os.path.exists(cache):
                try:
                    with open(cache, errors="replace") as f:
                        for line in f:
                            if line.startswith("CMAKE_BUILD_TYPE:"):
                                p.build_type = line.split("=", 1)[1].strip()
                                break
                        else:
                            p.build_type = ""
                except OSError:
                    pass
            p.changed = bool(p.newest_src and p.last_ok and p.newest_src > p.last_ok + 1)

    def scan_logs(self):
        """Error / warning counts of each package's last build log (uses cbfail)."""
        if not cbfail:
            return
        for p in list(self.pkgs.values()):
            if p.build_dir and p.status != "RUNNING":
                cp = cbfail.Package(p.name)
                try:
                    cbfail.load_output(cp, p.build_dir, full=False)
                except Exception:  # noqa
                    continue
                p.n_err, p.n_warn = cp.n_err, cp.n_warn
            else:
                p.n_err = p.n_warn = 0

    def scan_sources(self):
        """Newest file modification time in each package source tree."""
        for p in list(self.pkgs.values()):
            top = os.path.join(self.root, p.path)
            newest = 0.0
            for d, dirs, files in os.walk(top):
                dirs[:] = [x for x in dirs if not x.startswith(".") and x not in SKIP_DIRS
                           and not os.path.exists(os.path.join(d, x, "package.xml"))]
                for fn in files:
                    try:
                        mt = os.lstat(os.path.join(d, fn)).st_mtime
                    except OSError:
                        continue
                    if mt > newest:
                        newest = mt
            p.newest_src = newest or None
            p.changed = bool(p.newest_src and p.last_ok and p.newest_src > p.last_ok + 1)

    def closure(self, name, attr):
        seen, stack = set(), [name]
        while stack:
            for n in getattr(self.pkgs[stack.pop()], attr):
                if n not in seen:
                    seen.add(n)
                    stack.append(n)
        return seen


def load_settings(ws):
    try:
        with open(SETTINGS) as f:
            data = json.load(f).get(ws, {})
    except (OSError, ValueError):
        data = {}
    opts = dict(DEFAULT_OPTS)
    opts.update({k: v for k, v in data.items() if k in DEFAULT_OPTS})
    return opts


def save_settings(ws, opts):
    try:
        try:
            with open(SETTINGS) as f:
                data = json.load(f)
        except (OSError, ValueError):
            data = {}
        data[ws] = opts
        os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
        with open(SETTINGS, "w") as f:
            json.dump(data, f, indent=2)
    except OSError:
        pass


def build_cmd(opts, selection):
    cmd = ["colcon", "build", "--event-handlers", "console_cohesion+"]
    if opts["symlink"]:
        cmd.append("--symlink-install")
    if opts["continue_on_error"]:
        cmd.append("--continue-on-error")
    if opts["jobs"]:
        cmd += ["--parallel-workers", str(opts["jobs"])]
    if opts["clean_cache"]:
        cmd.append("--cmake-clean-cache")
    if opts["force_configure"]:
        cmd.append("--cmake-force-configure")
    cmd += selection
    cmd += shlex.split(opts["extra_colcon"] or "")
    cmake = []
    if opts["compile_commands"]:
        cmake.append("-DCMAKE_EXPORT_COMPILE_COMMANDS=ON")
    if opts["build_type"]:
        cmake.append(f"-DCMAKE_BUILD_TYPE={opts['build_type']}")
    cmake += shlex.split(opts["extra_cmake"] or "")
    if cmake:
        cmd += ["--cmake-args", *cmake]
    return cmd


# ---------------------------------------------------------------------------
# Plain output
# ---------------------------------------------------------------------------
def print_table(ws):
    tty = sys.stdout.isatty()
    col = {"OK": "32", "FAILED": "1;31", "ABORTED": "33", "SKIPPED": "35", "RUNNING": "36", "never": "2"}
    c = (lambda code, s: f"\033[{code}m{s}\033[0m") if tty else (lambda code, s: s)
    pk = sorted(ws.pkgs.values(), key=lambda p: p.order)
    nw = max([len(p.name) for p in pk] + [7])
    print(c("1", ws.root) + f"  ({len(pk)} packages)")
    for p in pk:
        bt = p.build_type if p.build_type else ("none" if p.build_type == "" else "-")
        ew = (f"E:{p.n_err} " if p.n_err else "") + (f"W:{p.n_warn}" if p.n_warn else "")
        print(f"  {p.name.ljust(nw)}  {p.short_type:<6}  {bt:<14}  "
              f"{c(col.get(p.status, '0'), f'{p.status:<8}')}  {ago(p.t_end):<11}  "
              f"{c('33', 'changed') if p.changed else '       '}  {ew}")


